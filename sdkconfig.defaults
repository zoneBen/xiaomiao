CONFIG_IDF_TARGET_ESP32=y

# Boat remote uses WiFi STA only. Bluetooth is excluded automatically because
# the bt component is not required and MINIMAL_BUILD is enabled.
CONFIG_LWIP_MAX_SOCKETS=4

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Networking events plus logs need a little more room.
CONFIG_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_MAIN_TASK_STACK_SIZE=3584

# Compiler optimization for size
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_NEWLIB_NANO_FORMAT=y
