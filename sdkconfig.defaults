CONFIG_IDF_TARGET_ESP32=y
CONFIG_LV_CONF_SKIP=y

# Disable WiFi to save memory (we use Bluetooth only)
CONFIG_ESP_WIFI_ENABLED=n

CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_USE_FONT_MONTSERRAT_14=y

# Disable MQTT to save memory (we use Bluetooth only)
CONFIG_MQTT_PROTOCOL_311=n
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_LWIP_MAX_SOCKETS=4


CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bluetooth Classic (Classic BT)
CONFIG_BT_ENABLED=y
CONFIG_BT_MODE_CLASSIC=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_A2DP_ENABLED=n
CONFIG_BT_AVRCP_ENABLED=n
CONFIG_BT_HFP_ENABLED=n
CONFIG_BT_HID_ENABLED=n
CONFIG_BT_PRF_ENABLED=n

# Bluetooth controller config
CONFIG_BT_CTRL=y
CONFIG_BT_CTRL_MODE_EFFORT=y
CONFIG_BT_CTRL_ACL_CONN_MAX=2
CONFIG_BT_CTRL_SCO_CONN_MAX=0
CONFIG_BT_CTRL_PAGE_SCAN_TYPE=1
CONFIG_BT_CTRL_INQ_SCAN_TYPE=1
CONFIG_BT_CTRL_HCI_MODE_VHCI=y
CONFIG_BT_CTRL_HCI_TL_CUSTOM=n
CONFIG_BT_CTRL_ADV_DUP_FILT_MAX=2
CONFIG_BT_CTRL_DUPL_SCAN_CACHE_MAX=10
CONFIG_BT_CTRL_SCAN_DUPL_TYPE=0

# Bluedroid config
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLUEDROID_SMP_ENABLE=n
CONFIG_BT_BLUEDROID_SMP_ENABLED=n
CONFIG_BT_BLUEDROID_GAP_SECURITY_MODE=0
CONFIG_BT_BLUEDROID_GAP_BOND_MAX=1
CONFIG_BT_BTU_TASK_STACK_SIZE=2048

# Optimize IRAM usage
CONFIG_ESP32_IRAM_0=0x8000
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_GATTS_ENABLE=n
CONFIG_BT_GATTC_ENABLE=n

# Compiler optimization for size
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Disable some debug features
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# Reduce stack sizes
CONFIG_MAIN_TASK_STACK_SIZE=3584
CONFIG_IDLE_TASK_STACK_SIZE=2048
CONFIG_SYSTEM_EVENT_TASK_STACK_SIZE=2304

# Disable unused features
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n
CONFIG_ETH_ENABLED=n
CONFIG_PPP_ENABLED=n
CONFIG_NEWLIB_NANO_FORMAT=y
